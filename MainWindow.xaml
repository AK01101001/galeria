<Window x:Class="galeria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:galeria"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <Image x:Name="obraz"  Width="400" Height="300" Source="zdj/zdj1.png"></Image>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="50" Height="50" Click="lewo">
                <Image Source="lewo.png"></Image>
            </Button>

            <TextBlock x:Name="wyswietlenia">wyswietlenia</TextBlock>
            <Button Width="50" Height="50" Click="prawo">
                <Image Source="prawo.png"></Image>

            </Button>

        </StackPanel>
        <Button Width="50" Click="polub">Polub</Button>
        <TextBlock x:Name="polubienia" HorizontalAlignment="Center">polubienia</TextBlock>
    </StackPanel>
</Window>
